# Baseline policy for ansible-lint CI.
#
# The rules below are skipped because they conflict with the existing house
# style, not because they are unimportant. Burn-down plan: remove one rule from
# skip_list per cleanup branch once the code has been fixed.
exclude_paths:
  - .venv-ansible/
  - inventories/group_vars/all/vault.yml   # operator symlink, never linted
skip_list:
  - var-naming[no-role-prefix]   # variables are shared across roles by design (gw_* inputs)
  - name[casing]                 # handler names are lowercase by convention
  - no-changed-when              # commands guarded by explicit when:/changed_when in most cases
  - no-handler                   # inline "when: X is changed" is deliberate for ordering
  - risky-shell-pipe             # shell tasks already use set -e / set -u
  - command-instead-of-module    # `git ls-remote` cannot be expressed with the git module
  - yaml[line-length]            # long inventory/template lines are intentional
  - cache[unpinned]              # apt cache_valid_time is set where it matters
  - jinja[invalid]                # role-default vars are unknown to static template analysis
  - yaml[empty-lines]            # single trailing blank line in tools/upstream-versions.yml
