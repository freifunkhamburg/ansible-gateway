net.ipv4.ip_forward=1
net.ipv4.ip_no_pmtu_disc=1
net.ipv4.route.flush=1
net.ipv4.conf.default.rp_filter=0
net.ipv4.conf.all.rp_filter=0
net.ipv4.icmp_errors_use_inbound_ifaddr=1
net.ipv4.neigh.default.gc_thresh1=4096
net.ipv4.neigh.default.gc_thresh2=8192
net.ipv4.neigh.default.gc_thresh3=16384
# Kernel 4.10+ moved these from net.ipv4.netfilter.* to net.netfilter.*.
net.netfilter.nf_conntrack_tcp_timeout_established=3600
net.netfilter.nf_conntrack_udp_timeout=60
net.ipv4.icmp_ratelimit=0
net.ipv6.conf.all.forwarding=1
net.ipv6.conf.all.autoconf=0
net.ipv6.conf.all.accept_ra=0
# Interfaces created AFTER boot (ifupdown) inherit these, not `all.*`.
# Gateway interfaces must never SLAAC or take an RA-provided default route:
# v6 routing is explicit (OSPFv3 default6 / intra-as gateway stanza).
net.ipv6.conf.default.autoconf=0
net.ipv6.conf.default.accept_ra=0
net.ipv6.neigh.default.gc_thresh1=4096
net.ipv6.neigh.default.gc_thresh2=8192
net.ipv6.neigh.default.gc_thresh3=16384
net.ipv6.icmp.ratelimit=0
net.netfilter.nf_conntrack_max=262144
net.core.netdev_max_backlog=8192
net.ipv4.neigh.default.unres_qlen=100
net.ipv6.neigh.default.unres_qlen=100
net.core.somaxconn=1024
#net.core.default_qdisc=fq
net.core.rmem_max=83886080
net.core.wmem_max=83886080
net.core.rmem_default=83886080
net.core.wmem_default=83886080
net.core.optmem_max=83886080
net.ipv4.udp_mem=65536 131072 262144
net.ipv4.udp_rmem_min=16384
net.ipv4.udp_wmem_min=16384
net.ipv4.fwmark_reflect=1
net.ipv6.fwmark_reflect=1
# A forwarding router must neither send nor act on ICMP redirects (RFC 4861
# §6.2.7 restricts sending to first-hop routers, §6.3.2 says routers never
# accept them). Sent redirects advertise topology to clients for no benefit
# here; accepted ones would let any transit host steer this stack's routes.
# The kernel combines `all` with the per-interface value, so the base role
# also zeroes the interfaces that exist at apply time.
net.ipv4.conf.all.send_redirects=0
net.ipv4.conf.default.send_redirects=0
net.ipv6.conf.all.accept_redirects=0
net.ipv6.conf.default.accept_redirects=0
