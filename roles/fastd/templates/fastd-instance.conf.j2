include "/etc/fastd/common.conf";
interface "{{ item.iface }}";
{% for addr in (fastd_bind_addresses if fastd_bind_addresses else ['any']) %}
bind {% if ':' in addr %}[{{ addr }}]{% else %}{{ addr }}{% endif %}:{{ item.port }};
{% endfor %}
include "/etc/fastd/secret-{{ item.name }}.conf";
status socket "{{ fastd_status_socket_dir }}/fastd-status.{{ item.iface | replace('vpn-', '') }}.sock";
include peers from "{{ fastd_peer_dir }}";
