# Netfilter rules for {{ ffhh_host_name }} (Debian 13 base).
#
# Default-deny: INPUT and FORWARD start at DROP and every listener is named
# explicitly. Established flows are accepted by conntrack before the per-port
# rules; the raw table keeps the tunnel and VXLAN data plane out of conntrack
# altogether.
#
# Gateway identity (public block, SNAT range, transit net, SSH allowlist)
# comes from host_vars; the mesh aggregate and the forwarded community /32s
# come from group_vars. Port ranges, MSS clamp, fwmark, hashlimit rates and
# the log prefix are policy and stay literal.

*mangle
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -i {{ uplink_if }} -j MARK --set-xmark 0x1/0xffffffff
-A PREROUTING -i bat-+ -j MARK --set-xmark 0x1/0xffffffff
COMMIT

*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# --- fast path ---------------------------------------------------------
# Tunnel/VXLAN flows are NOTRACKed above, so they arrive as NEW and are
# matched by their own rules below. Everything else is tracked.
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# --- OSPFv2: uplink transit + bat interfaces --------------------------
# BIRD runs OSPFv2 on the uplink (transit /29, Hellos to 224.0.0.5) and on
# the bat interfaces (mesh addresses). It is multicast and non-stateful, so
# it is admitted *before* the conntrack INVALID check: multicast/broadcast
# packets can otherwise be classified INVALID and dropped. OSPF carries no
# authentication here, so the transit accept is pinned to the known peer:
# an unauthenticated neighbour offer must not stand against the whole
# transit segment.
-A INPUT -i {{ uplink_if }} -s {{ uplink_v4_peer }} -p ospf -j ACCEPT
-A INPUT -s {{ mesh_v4_aggregate }} -p ospf -j ACCEPT
-A INPUT -p ospf -j DROP

-A INPUT -m conntrack --ctstate INVALID -j DROP
-A INPUT -i lo -j ACCEPT

# --- ICMP: signalling allowed, echo request rate-limited per source ----
# The per-source bucket is the policy; the aggregate bucket behind it only
# bounds the work the host does under a flood with spoofed sources, which
# any per-source limit cannot see.
-A INPUT -p icmp -m icmp --icmp-type 0 -j ACCEPT
-A INPUT -p icmp -m icmp --icmp-type 3 -j ACCEPT
-A INPUT -p icmp -m icmp --icmp-type 11 -j ACCEPT
-A INPUT -p icmp -m icmp --icmp-type 12 -j ACCEPT
-A INPUT -p icmp -m icmp --icmp-type 8 -m hashlimit --hashlimit-name fw-icmp --hashlimit-upto 5/second --hashlimit-burst 10 --hashlimit-mode srcip -j ACCEPT
-A INPUT -p icmp -m icmp --icmp-type 8 -m hashlimit --hashlimit-name fw-icmp-agg4 --hashlimit-above 1000/second --hashlimit-burst 2000 --hashlimit-mode dstip -j DROP
-A INPUT -p icmp -j DROP

# --- SSH: operator allowlist; everything else is rejected --------------
# One ACCEPT rule per prefix, then LOG + REJECT. Deliberately not a user chain:
# a chain that returns for allowed sources falls back into INPUT and ends at the
# DROP policy, which is how the first version of this ruleset locked out SSH.
{% for n in gw_ssh_allowlist %}
-A INPUT -p tcp -m tcp --dport 22 -s {{ n }} -j ACCEPT
{% endfor %}
-A INPUT -p tcp -m tcp --dport 22 -m limit --limit 5/min -j LOG --log-prefix "{{ ffhh_host_name }} ssh-reject: " --log-level 4
-A INPUT -p tcp -m tcp --dport 22 -j REJECT --reject-with icmp-port-unreachable

# --- DHCPv4 server -----------------------------------------------------
# A client without a lease sends DISCOVER from 0.0.0.0; RENEW/REQUEST come
# from the leased mesh address. DISCOVERs exist only on the mesh-facing
# interfaces, so uplink and intra-as are closed before the accepts — the
# server must not be reachable unleased from either transit segment.
-A INPUT -i {{ uplink_if }} -p udp -m udp --dport 67 -j DROP
-A INPUT -i {{ intra_as_if }} -p udp -m udp --dport 67 -j DROP
-A INPUT -p udp -m udp --dport 67 -s 0.0.0.0/32 -j ACCEPT
-A INPUT -s {{ mesh_v4_aggregate }} -p udp -m udp --dport 67 -j ACCEPT
-A INPUT -p udp -m udp --dport 67 -j DROP

# --- Client resolver (kresd): mesh clients only ------------------------
-A INPUT -s {{ mesh_v4_aggregate }} -p udp -m udp --dport 53 -j ACCEPT
-A INPUT -s {{ mesh_v4_aggregate }} -p tcp -m tcp --dport 53 -j ACCEPT
-A INPUT -p udp -m udp --dport 53 -j DROP
-A INPUT -p tcp -m tcp --dport 53 -j DROP

# --- fastd tunnels: public, but not from the mesh or the intra-as /24 ---
-A INPUT -s {{ mesh_v4_aggregate }} -p udp -m udp --dport 10000:10010 -j DROP
-A INPUT -s {{ gw_public_net }} -p udp -m udp --dport 10000:10010 -j DROP
-A INPUT -p udp -m udp --dport 10000:10010 -j ACCEPT

# --- VXLAN: intra-as segment only --------------------------------------
-A INPUT -i {{ intra_as_if }} -p udp -m udp --dport 4789 -j ACCEPT
-A INPUT -p udp -m udp --dport 4789 -j DROP

# --- respondd: mesh clients only ---------------------------------------
-A INPUT -s {{ mesh_v4_aggregate }} -p udp -m udp --dport 1001 -j ACCEPT
-A INPUT -p udp -m udp --dport 1001 -j DROP

# --- NTP: public, rate-limited per source ------------------------------
# Aggregate ceiling behind the per-source bucket (see the ICMP note).
-A INPUT -p udp -m udp --dport 123 -m hashlimit --hashlimit-name fw-ntp --hashlimit-upto 20/second --hashlimit-burst 40 --hashlimit-mode srcip -j ACCEPT
-A INPUT -p udp -m udp --dport 123 -m hashlimit --hashlimit-name fw-ntp-agg4 --hashlimit-above 500/second --hashlimit-burst 1000 --hashlimit-mode dstip -j DROP
-A INPUT -p udp -m udp --dport 123 -j DROP

# --- status page -------------------------------------------------------
# Guards first: these two rules only drop packets *over* their token bucket
# respectively connection count, normal traffic falls through to the
# accept/drop decisions below. Public exposure (v6) is why the listener
# carries its own budget even though the v4 page is not announced.
-A INPUT -p tcp -m tcp --dport 80 -m tcp --tcp-flags SYN,RST SYN -m hashlimit --hashlimit-name fw-http-syn4 --hashlimit-above 50/second --hashlimit-burst 100 --hashlimit-mode srcip -j DROP
-A INPUT -p tcp -m tcp --dport 80 -m connlimit --connlimit-above 50 -j DROP
-A INPUT -i lo -p tcp -m tcp --dport 80 -m comment --comment "status page: local health checks" -j ACCEPT
-A INPUT -i {{ intra_as_if }} -p tcp -m tcp --dport 80 -m comment --comment "status page: intra-as peers" -j ACCEPT
-A INPUT -s {{ mesh_v4_aggregate }} -p tcp -m tcp --dport 80 -m comment --comment "status page: mesh clients" -j ACCEPT
-A INPUT -p tcp -m tcp --dport 80 -m comment --comment "status page: not a listener" -j DROP

# --- non-listening ports ----------------------------------------------
-A INPUT -p udp -m udp --dport 5000:5010 -j DROP
-A INPUT -p tcp -m tcp --dport 161 -j DROP
-A INPUT -p tcp -m tcp --dport 9000:9999 -j DROP

# --- anything else: visible, not silent -------------------------------
-A INPUT -m limit --limit 5/min -j LOG --log-prefix "{{ ffhh_host_name }} input-drop: " --log-level 4

# --- forwarding -------------------------------------------------------
# MSS clamps first, for both handshake directions. A mesh client (effective
# path MTU 1312 through fastd/VXLAN) and an internet server (1500) each
# advertise a segment size the other's path cannot carry, and PMTU discovery
# cannot be trusted as the bound: its ICMP answers travel the reverse of an
# independently chosen return path and are commonly lost — the visible
# failure is TCP that stalls after the handshake. The SYN clamp bounds
# server->client data; the SYN-ACK clamp bounds client->server data, i.e. it
# caps a client's uploads to what the mesh can carry. The flag masks are
# exact (SYN,ACK,RST SYN and SYN,ACK SYN,ACK): the looser SYN,RST SYN would
# also match SYN-ACK packets and let the first rule silently absorb the
# second one's traffic. Neither clamp is bound to an interface pair on
# purpose: mesh-internal sessions reach a smaller effective MTU too (VXLAN
# overhead between gateways). Both must precede every ACCEPT: TCPMSS is
# non-terminating, an ACCEPT ends the traversal — and for conntrack a
# SYN-ACK is already ESTABLISHED, so the clamps even precede the fast path.
-A FORWARD -p tcp -m tcp --tcp-flags SYN,ACK,RST SYN -m tcpmss ! --mss 0:1240 -j TCPMSS --set-mss 1240
-A FORWARD -p tcp -m tcp --tcp-flags SYN,ACK SYN,ACK -m tcpmss ! --mss 0:1240 -j TCPMSS --set-mss 1240
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A FORWARD -m conntrack --ctstate INVALID -j DROP
-A FORWARD ! -s {{ mesh_v4_aggregate }} -o {{ uplink_if }} -j DROP
-A FORWARD -s {{ mesh_v4_aggregate }} -o {{ uplink_if }} -j ACCEPT
# mesh-internal: a client reaching a client in another region traverses two
# bat interfaces (mirror of the v6 rule); the return packets are covered by
# the ESTABLISHED fast path.
-A FORWARD -s {{ mesh_v4_aggregate }} -i bat-+ -o bat-+ -j ACCEPT
{% for h in mesh_forward_hosts %}
-A FORWARD -d {{ h.dest }} -i {{ uplink_if }} -o bat-+ -j ACCEPT
{% endfor %}
-A FORWARD -m limit --limit 5/min -j LOG --log-prefix "{{ ffhh_host_name }} forward-drop: " --log-level 4
COMMIT

*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A POSTROUTING -s {{ gw_transit_net }} -o {{ uplink_if }} -j RETURN
-A POSTROUTING -s {{ mesh_v4_aggregate }} -o {{ uplink_if }} -j SNAT --to-source {{ gw_public_snat_range }}
COMMIT

*raw
:PREROUTING ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
-A PREROUTING -i {{ intra_as_if }} -p udp -m udp --dport 10000:10010 -j NOTRACK
-A PREROUTING -i {{ intra_as_if }} -p udp -m udp --dport 4789 -j NOTRACK
-A PREROUTING -i {{ uplink_if }} -p udp -m udp --dport 4789 -j NOTRACK
-A OUTPUT -o {{ intra_as_if }} -p udp -m udp --sport 10000:10010 -j NOTRACK
-A OUTPUT -o {{ intra_as_if }} -p udp -m udp --dport 4789 -j NOTRACK
-A OUTPUT -o {{ uplink_if }} -p udp -m udp --dport 4789 -j NOTRACK
COMMIT
