-- Synthesised IPv4 client PTRs from Kea leases.
--
-- OPT-IN: only loaded when knot_client_ptr_enabled is true (see
-- docs/knot-resolver.md). The upstream community DNS serves no PTRs for the
-- mesh /16 (`112.10.in-addr.arpa` answers NXDOMAIN); this answers the name
-- from the lease database instead, so a resolver query reveals that an
-- address is currently leased. That is a privacy decision, hence the toggle.
--
-- Name pattern mirrors the upstream IPv6 client naming:
--   10.112.65.37 -> ipv4-0a704125.<region>.clients.hamburg.freifunk.net.
-- It is the 32-bit address in 8 hex nibbles (the IPv6 convention uses the
-- 64-bit host part in 16 nibbles).
--
-- Lease data is exported by knot-client-ptr-export (systemd timer) to a
-- kresd-readable file so the resolver user never needs access to Kea's DB.

local ffi = require('ffi')

local leases = '{{ knot_client_ptr_leases }}'
local zone = '112.10.in-addr.arpa'
local ttl = 3600
local refresh = 5          -- seconds; leases change slowly, this is cheap

local regions = {
{% for r in served_regions %}
  { net = '{{ r.v4_net }}', label = '{{ r.id | regex_replace('^hh', '') }}' },
{% endfor %}
}

local function to_int(s)
    local a, b, c, d = s:match('^(%d+)%.(%d+)%.(%d+)%.(%d+)$')
    if not a then return nil end
    return ((tonumber(a) * 256 + tonumber(b)) * 256 + tonumber(c)) * 256 + tonumber(d)
end

local function region_for(addr)
    local v = to_int(addr)
    if v == nil then return nil end
    for _, r in ipairs(regions) do
        local net, bits = r.net:match('^([%d%.]+)/(%d+)$')
        local n = to_int(net)
        if n ~= nil then
            local size = 2 ^ (32 - tonumber(bits))
            if math.floor(v / size) == math.floor(n / size) then
                return r.label
            end
        end
    end
    return nil
end

local cache = { at = -1, map = {} }

-- kresd's qname is a dname cdata; kres.dname2str() converts it to presentation
-- form. Keys are normalised (lower case, no trailing dot) on both sides.
local function norm(name)
    if name == nil then return nil end
    return (name:lower()):gsub('%.$', '')
end

local function table_for()
    local now = os.time()
    if now - cache.at < refresh then return cache.map end
    local map = {}
    local f = io.open(leases, 'r')
    if f then
        for line in f:lines() do
            local addr, rest = line:match('^([^,]+),(.*)$')
            -- columns: address,hwaddr,client_id,valid_lifetime,expire,...
            local expire = rest:match('^[^,]*,[^,]*,%d+,(%d+)')
            if addr and expire and tonumber(expire) > now then
                local label = region_for(addr)
                local a, b, c, d = addr:match('^(%d+)%.(%d+)%.(%d+)%.(%d+)$')
                local v = math.floor(to_int(addr))
                if label and v ~= nil and a then
                    local rev = norm(d .. '.' .. c .. '.' .. zone .. '.')
                    map[rev] = string.format('ipv4-%08x.%s.clients.hamburg.freifunk.net.', v, label)
                end
            end
        end
        f:close()
    end
    cache.at, cache.map = now, map
    return map
end

policy.add(policy.suffix(function(state, req)
    local qry = req:current()
    if qry.stype ~= kres.type.PTR then return nil end
    local target = table_for()[norm(kres.dname2str(qry.sname))]
    if target == nil then return nil end   -- fall through to the forwarded zone
    local answer = req:ensure_answer()
    if answer == nil then return nil end
    ffi.C.kr_pkt_make_auth_header(answer)
    answer:rcode(kres.rcode.NOERROR)
    answer:begin(kres.section.ANSWER)
    for _, rdata in ipairs(kres.parse_rdata({'PTR ' .. target})) do
        answer:put(qry.sname, ttl, qry.sclass, kres.type.PTR, rdata)
    end
    return kres.DONE
end, {todname(zone)}))
