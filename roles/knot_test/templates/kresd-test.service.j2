[Unit]
Description=Knot Resolver test instance (ffhh DNS mirror, port {{ knot_test_port }}, built from source)
Documentation=man:kresd(8)
Wants=network-online.target
After=network-online.target
Before=nss-lookup.target
Wants=nss-lookup.target

[Service]
Type=notify
ExecStart={{ knot_test_bin }} -c {{ knot_test_conf }} -n
User={{ knot_test_user }}
Group={{ knot_test_user }}
WorkingDirectory={{ knot_test_workdir }}
RuntimeDirectory=knot-resolver-test
RuntimeDirectoryMode=0755
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETPCAP
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SETPCAP
Restart=on-abnormal
TimeoutStopSec=10s
LimitNOFILE=524288
Slice=system-kresd.slice

[Install]
WantedBy=multi-user.target
