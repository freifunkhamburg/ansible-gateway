# respondd config for gw05, generated by roles/mesh_announce.
#
# One process serves every domain. The section names are the Gluon domain names
# (site-ffhh/domains/*.conf) and BatmanInterface maps each to the ffhh gateway
# bat-<region> interface. A request is answered by the domain of the interface
# it arrived on; there is intentionally no DefaultDomain, so requests on
# unregistered interfaces are ignored instead of being answered with a random
# region's data.
#
# Domains: {{ mesh_announce_domains | map(attribute='domain') | join(', ') }}

[Defaults]
Port: 1001
MulticastLinkAddress: ff02::2:1001
MulticastSiteAddress: ff05::2:1001
DomainType: batadv
VPNProtocols: fastd
Hostname: {{ ffhh_host_name }}
VPN: True

{% for d in mesh_announce_domains %}
[{{ d.domain }}]
DomainType: batadv
BatmanInterface: {{ d.bat_if }}
VPNProtocols: fastd
Hostname: {{ ffhh_host_name }}
VPN: True

{% endfor %}
