#!/usr/bin/env python3
"""ffhh-dns-fetch — transfer the community zones served by the local
PowerDNS (roles/powerdns) and emit the Lua data file the backend loads.

dig AXFR against the community masters, keep the last good copy per zone
(in a JSON cache) and regenerate the Lua file atomically.  Never removes
records on a failed transfer: zones only go stale, not empty.
"""
import json
import os
import subprocess
import sys
import tempfile

MASTERS = {{ ffhh_dns_axfr_masters | to_json }}
ZONES = {{ ffhh_dns_axfr_zones | to_json }}
OUT = "{{ ffhh_dns_data }}"
CACHE = "{{ ffhh_dns_data }}.cache.json"


def dig_axfr(zone):
    """Return (rows, serial) or None. rows = [owner, ttl, type, rdata]."""
    for master in MASTERS:
        try:
            p = subprocess.run(
                ["dig", "+noall", "+answer", "+time=5", "+tries=2",
                 "-t", "AXFR", zone, "@" + master],
                capture_output=True, text=True, timeout=30, check=False)
        except Exception as e:  # noqa: BLE001
            print("axfr %s from %s failed: %s" % (zone, master, e), file=sys.stderr)
            continue
        rows = []
        for line in p.stdout.splitlines():
            parts = line.split()
            if len(parts) < 5 or not parts[1].isdigit():
                continue  # header junk or rdata continuation (none expected)
            owner, ttl, _cls, rtype = parts[0], parts[1], parts[2], parts[3]
            rdata = line.split(None, 4)[4].strip()
            rows.append([owner.lower().rstrip("."), int(ttl), rtype, rdata])
        serial = 0
        apex = zone.rstrip(".")
        for owner, _ttl, rtype, rdata in rows:
            if rtype == "SOA" and owner == apex:
                serial = int(rdata.split()[2])
        # SOA appears twice in an AXFR; keep only the first.
        seen_soa = False
        deduped = []
        for row in rows:
            if row[2] == "SOA" and row[0] == apex:
                if seen_soa:
                    continue
                seen_soa = True
            deduped.append(row)
        if deduped and serial:
            print("axfr %s from %s: %d records, serial %d"
                  % (zone, master, len(deduped), serial))
            return deduped, serial
        print("axfr %s from %s: no/invalid transfer (%s)"
              % (zone, master, p.stdout.splitlines()[0] if p.stdout else "empty"),
              file=sys.stderr)
    return None


def lua_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def main():
    state = {}
    if os.path.exists(CACHE):
        try:
            with open(CACHE, encoding="utf-8") as f:
                state = json.load(f)
        except Exception:  # noqa: BLE001
            state = {}

    failures = 0
    for zone in ZONES:
        got = dig_axfr(zone)
        if got is None:
            failures += 1
            continue
        rows, serial = got
        state[zone.rstrip(".")] = {"serial": serial, "records": rows}

    # Emit the Lua data file from the merged state.
    out = ["-- Generated by ffhh-dns-fetch; do not edit.", "local zones = {}"]
    for apex, info in sorted(state.items()):
        out.append("zones[%s] = { serial = %d, recs = {} }"
                   % (lua_str(apex + "."), info["serial"]))
    for apex, info in sorted(state.items()):
        per_name = {}
        for owner, ttl, rtype, rdata in info["records"]:
            per_name.setdefault(owner + ".", []).append((rtype, rdata, ttl))
        for name, recs in sorted(per_name.items()):
            items = ", ".join("{ %s, %s, %d }" % (lua_str(t), lua_str(c), ttl)
                              for t, c, ttl in recs)
            out.append("zones[%s].recs[%s] = { %s }"
                       % (lua_str(apex + "."), lua_str(name), items))
    out.append("return zones")

    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(OUT), prefix=".zones.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write("\n".join(out) + "\n")
        os.chmod(tmp, 0o644)
        os.replace(tmp, OUT)
    except Exception:
        os.unlink(tmp)
        raise

    with open(CACHE, "w", encoding="utf-8") as f:
        json.dump(state, f)

    if failures:
        print("%d zone(s) failed to transfer; kept previous data" % failures,
              file=sys.stderr)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
